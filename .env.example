# Copy to .env and adjust. Every value is optional - the defaults work out of the box.

# --- database ----------------------------------------------------------
# SQLite (default):
PCC_DATABASE_URL=sqlite:///./data/people_counter.db
# PostgreSQL (switch with a single value):
# PCC_DATABASE_URL=postgresql+psycopg://people:secret@localhost:5432/people_counter

# --- security ----------------------------------------------------------
PCC_SECRET_KEY=gun.gun0914
PCC_ACCESS_TOKEN_MINUTES=60
PCC_REFRESH_TOKEN_DAYS=14
PCC_DEFAULT_ADMIN_USERNAME=admin
PCC_DEFAULT_ADMIN_PASSWORD=admin123
PCC_FORCE_PASSWORD_CHANGE=true

# --- API ---------------------------------------------------------------
PCC_API_ENABLED=false
PCC_API_HOST=127.0.0.1
PCC_API_PORT=8000
# Web UI launcher: auto (default) serves web-ui/dist when built, otherwise
# starts the Vite dev server and opens the browser. Set to off to disable.
PCC_WEB_UI=auto
PCC_CORS_ORIGINS="127.0.0.1"
PCC_RATE_LIMIT_LOGIN_PER_MINUTE=10
# PCC_WEBHOOK_URLS=http://localhost:9000/hook,http://localhost:9000/hook2

# --- detection ---------------------------------------------------------
PCC_MODEL_NAME=yolov8n.pt
PCC_CONFIDENCE=0.4
PCC_IOU=0.7
PCC_IMGSZ=640
PCC_DEVICE=auto
PCC_BATCH_SIZE=4
PCC_BATCH_WINDOW_MS=40

# --- counting ----------------------------------------------------------
PCC_TRACK_POINT=bottom
PCC_COUNTING_COOLDOWN_S=1.5
PCC_COUNTING_MIN_DISPLACEMENT=0.015

# --- logging -----------------------------------------------------------
PCC_LOG_LEVEL=INFO
